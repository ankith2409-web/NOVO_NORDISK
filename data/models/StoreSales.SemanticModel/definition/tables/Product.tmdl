/// What is being sold, and how it is grouped for reporting.
table Product

	column ProductID
		dataType: int64
		isKey
		summarizeBy: none
		sourceColumn: ProductID

	column ProductName
		dataType: string
		summarizeBy: none
		sourceColumn: ProductName

	/// Technology, Furniture, Office Supplies.
	column Category
		dataType: string
		summarizeBy: none
		sourceColumn: Category

	column SubCategory
		dataType: string
		summarizeBy: none
		sourceColumn: SubCategory

	hierarchy 'Product Range'

		level Category
			column: Category

		level SubCategory
			column: SubCategory

		level Product
			column: ProductName

	partition Product = m
		mode: import
		source = ```
			let
			    Source = Csv.Document(File.Contents("product.csv"), [Delimiter=","]),
			    Promoted = Table.PromoteHeaders(Source)
			in
			    Promoted
			```
