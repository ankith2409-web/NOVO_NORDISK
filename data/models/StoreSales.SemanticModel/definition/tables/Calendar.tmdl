/// A date table, which is what makes any comparison against an earlier period
/// possible at all.
table Calendar

	column Date
		dataType: dateTime
		formatString: yyyy-mm-dd
		isKey
		summarizeBy: none
		sourceColumn: Date

	column Year
		dataType: int64
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: int64
		summarizeBy: none
		sourceColumn: Quarter

	column Month
		dataType: int64
		summarizeBy: none
		sourceColumn: Month

	column MonthName
		dataType: string
		summarizeBy: none
		sourceColumn: MonthName

	hierarchy 'Calendar Periods'

		level Year
			column: Year

		level Quarter
			column: Quarter

		level Month
			column: MonthName

	partition Calendar = m
		mode: import
		source = ```
			let
			    Source = Csv.Document(File.Contents("calendar.csv"), [Delimiter=","]),
			    Promoted = Table.PromoteHeaders(Source)
			in
			    Promoted
			```
