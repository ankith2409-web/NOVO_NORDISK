/// Every figure this model reports. A measure container: it holds definitions
/// rather than data, which is why it needs one hidden placeholder column.
///
/// The first five are the tiles across the top of the dashboard this model was
/// written against -- Total Sales, Total Profit, Profit Margin, Orders,
/// Products -- named exactly as they appear there so that a reader holding the
/// report and a reader holding this document are looking at the same words.
table 'Sales Metrics'

	column Placeholder
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Placeholder

	/// Units sold times what each unit sold for. Stated the way anyone would
	/// state it, and computed line by line so a discounted line counts at the
	/// price it actually went out at.
	measure 'Total Sales' = SUM(Sales[Line Sales])
		formatString: \$#,0
		displayFolder: Headline

	/// What we paid for what we sold.
	measure 'Total Cost' = SUM(Sales[Line Cost])
		formatString: \$#,0
		displayFolder: Headline

	/// Sales less cost. Nothing else is netted off here -- no overheads, no
	/// returns -- so this is gross profit, and its description says so rather
	/// than leaving a reader to assume otherwise.
	measure 'Total Profit' = [Total Sales] - [Total Cost]
		formatString: \$#,0
		displayFolder: Headline

	/// Profit as a share of sales. BLANK rather than zero when there are no
	/// sales, because a margin on nothing is not 0% -- it does not exist, and
	/// showing 0% would drag every average that touches it downwards.
	measure 'Profit Margin' = DIVIDE([Total Profit], [Total Sales], BLANK())
		formatString: 0.00%
		displayFolder: Headline

	/// Orders, not order lines. One order of three items is one order, so this
	/// counts the distinct order number rather than the rows.
	measure Orders = DISTINCTCOUNT(Sales[OrderID])
		formatString: #,0
		displayFolder: Headline

	/// How many different products actually sold, which is not the same as how
	/// many the catalogue lists.
	measure Products = DISTINCTCOUNT(Sales[ProductID])
		formatString: #,0
		displayFolder: Headline

	measure 'Units Sold' = SUM(Sales[Units])
		formatString: #,0
		displayFolder: Headline

	/// What one order was worth on average.
	measure 'Average Order Value' = DIVIDE([Total Sales], [Orders], BLANK())
		formatString: \$#,0.00
		displayFolder: Headline

	/// The same sales figure, one month earlier. Every retail dashboard has
	/// this pair, and it is the shape a reviewer specifically asked to see
	/// converted into SQL.
	measure 'Total Sales PM' = CALCULATE([Total Sales], PREVIOUSMONTH('Calendar'[Date]))
		formatString: \$#,0
		displayFolder: Month on month

	/// This month against last. Positive is growth.
	measure 'Sales vs PM' = [Total Sales] - [Total Sales PM]
		formatString: \$#,0
		displayFolder: Month on month

	measure 'Total Profit PM' = CALCULATE([Total Profit], PREVIOUSMONTH('Calendar'[Date]))
		formatString: \$#,0
		displayFolder: Month on month

	/// Growth as a percentage, blank in the first month because there is
	/// nothing before it to compare against.
	measure 'Sales Growth %' = DIVIDE([Sales vs PM], [Total Sales PM], BLANK())
		formatString: 0.0%
		displayFolder: Month on month

	/// A plain-language verdict on the margin, the kind of thing a report puts
	/// in a coloured pill.
	measure 'Margin Health' =
			SWITCH(
			    TRUE(),
			    [Profit Margin] >= 0.3, "Healthy",
			    [Profit Margin] >= 0.15, "Acceptable",
			    "Below target"
			)
		displayFolder: Headline

	/// Deliberately left as something no single query can answer, so this model
	/// demonstrates a refusal as well as a translation: it compares each row
	/// against the whole table regardless of what the report is filtered to.
	measure 'Share of All Sales' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALL(Sales)), BLANK())
		formatString: 0.0%
		displayFolder: Headline
