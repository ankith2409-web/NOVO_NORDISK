relationship Sales_Product
	fromColumn: Sales.ProductID
	toColumn: Product.ProductID
	toCardinality: one

relationship Sales_Customer
	fromColumn: Sales.CustomerID
	toColumn: Customer.CustomerID
	toCardinality: one

relationship Sales_Store
	fromColumn: Sales.StoreID
	toColumn: Store.StoreID
	toCardinality: one

relationship Sales_Calendar
	fromColumn: Sales.OrderDate
	toColumn: Calendar.Date
	toCardinality: one

/// The date an order shipped, rather than the date it was placed. Inactive
/// because a model may have only one active path to the calendar; a measure
/// that wants to count by dispatch has to ask for it deliberately.
relationship Sales_Calendar_Shipped
	fromColumn: Sales.ShipDate
	toColumn: Calendar.Date
	toCardinality: one
	isActive: false
