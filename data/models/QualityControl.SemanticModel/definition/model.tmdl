/// Manufacturing quality control: batch release, test results, OOS tracking.
/// Synthetic model authored for the Novo Nordisk GBS Hackathon 2026 -- structure
/// mirrors real GMP quality operations, no real batch or product data is present.
model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3

ref table Batch
ref table TestResult
ref table Product
ref table Site
ref table Calendar
ref table 'QC Metrics'
