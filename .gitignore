.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Generated graphs — reproducible from data/models via `concordance extract`
data/out/

# Sample .pbix models are binaries and are kept out of version control by
# default -- with two exceptions, un-ignored below. Tests skip cleanly when an
# ignored one is absent.
#
# The exceptions are there because the deployed demo serves them, and a
# gitignored file is simply not present in a fresh clone: the container would
# have exited on boot with "no such file or folder", taking the whole demo down
# on a Sunday. They are also the point of the demo now -- a reviewer asked to
# see this run against a Power BI file nobody here authored, and a sample that
# only exists on one laptop cannot answer that.
# Only the binaries are excluded -- TMDL models are text and belong in git.
data/models/*.pbix
!data/models/Supply_Chain_Sample.pbix
!data/models/Sales_Returns_Sample.pbix
# The demo model. Microsoft's own Store Sales sample, unmodified: five tables,
# a real report layer, and a domain nobody needs explained.
!data/models/StoreSales.pbix

.env
.DS_Store

# Generated warehouse — reproducible via `scripts/build_warehouse.py`
data/warehouse/

# Generated snapshots — reproducible via `concordance snapshot`
data/snapshots/

# Vite dependency cache, created when the dev server is run from here
.vite/

# Build output for the embedded interface; the shipped copy is
# concordance/web/static/app.html, which is tracked deliberately.
frontend/dist-embedded/
