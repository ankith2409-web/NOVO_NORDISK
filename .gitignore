.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/

# Generated graphs — reproducible from data/models via `concordance extract`
data/out/

# Sample .pbix models (~16MB of binaries). Kept out of version control; place
# them in data/models/ locally. Tests skip cleanly when they are absent.
# Only the binaries are excluded -- TMDL models are text and belong in git.
data/models/*.pbix

.env
.DS_Store

# Generated warehouse — reproducible via `scripts/build_warehouse.py`
data/warehouse/

# Generated snapshots — reproducible via `concordance snapshot`
data/snapshots/

# Vite dependency cache, created when the dev server is run from here
.vite/

# Build output for the embedded interface; the shipped copy is
# concordance/web/static/app.html, which is tracked deliberately.
frontend/dist-embedded/
